{
  "endpoint": "wss://api.deepgram.com/v1/listen",
  "api_key_env": "DEEPGRAM_API_KEY",
  "audio": {
    "encoding": "linear16",
    "sample_rate": 8000,
    "sample_width_bits": 16,
    "channels": 1,
    "chunk_size_ms": 20,
    "realtime_pacing": true,
    "tail_silence_ms": 800
  },
  "transcription": {
    "model": "nova-3",
    "language": "ar",
    "interim_results": true,
    "endpointing": 500,
    "utterance_end_ms": 1000,
    "vad_events": true,
    "punctuate": true,
    "smart_format": false,
    "numerals": false,
    "keyterm": []
  },
  "connection": {
    "open_timeout_seconds": 10.0,
    "close_timeout_seconds": 10.0,
    "finalize_timeout_seconds": 10.0,
    "keepalive_interval_seconds": 5.0,
    "max_message_bytes": 10485760
  },
  "batch": {
    "library": "library_ar",
    "manifest": "benchmarks/library_ar/arabic_asr_benchmark_sheet3.csv",
    "benchmark_id_column": "Benchmark ID",
    "dialect_column": "Dialect",
    "audio_path_column": "wav",
    "reference_columns": [
      "Annotation Text(pure Arabic/number formatted)",
      "Annotation Text (with code-switching)"
    ],
    "language_by_dialect": {
      "Omani Arabic": "ar",
      "Saudi Arabic (provisional)": "ar-SA",
      "Saudi/Gulf Arabic (provisional)": "ar-SA"
    },
    "concurrency": 5,
    "results_directory": "benchmarks/library_ar/test-results/deepgram"
  }
}
