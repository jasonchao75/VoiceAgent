# Runtime-only settings. Deepgram and LLM credentials are BYOK and must not be stored here.
VOICE_AGENT_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
VOICE_AGENT_LOG_LEVEL=INFO
VOICE_AGENT_BIND_ADDRESS=127.0.0.1
VOICE_AGENT_PORT=8000

# Required for a protected public demo. Leave both unset for local development.
# VOICE_AGENT_BASIC_AUTH_USERNAME=voiceagent
# VOICE_AGENT_BASIC_AUTH_PASSWORD=replace-with-a-password-of-at-least-8-characters

# Bot configuration persistence. VOICE_AGENT_DATA_DIR defaults to ./data locally
# and is pinned to /data inside the container.
# VOICE_AGENT_DATA_DIR=./data
# Optional master key that encrypts bot-level API keys at rest. Without it,
# bots still work but the "save API keys" option stays disabled. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up somewhere safe: losing it makes every saved key undecryptable.
# VOICE_AGENT_STORAGE_KEY=
